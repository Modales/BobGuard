# Sandbox service settings. Copy this file to .env and set a real password.
# .env is ignored by git; this example file is safe to commit.

# Used by the Postgres container (bob-sandbox-db) AND by the sandbox app.
POSTGRES_USER=sandbox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sandbox_runs

# Where the sandbox app finds the database.
# From your computer: localhost:5433
# From a container on the bob-net Docker network: bob-sandbox-db:5432
DB_HOST=localhost
DB_PORT=5433
